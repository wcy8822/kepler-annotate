{
  "name": "kepler-annotate",
  "version": "1.4.0",
  "private": true,
  "description": "Tests for the Kepler Annotate browser extension and local project sync",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test tests/*.test.cjs",
    "test:python": "node tests/helpers.cjs python",
    "test:ui": "node tests/project-ui.cjs",
    "test:e2e": "node tests/project-local-e2e.cjs",
    "browsers:install": "playwright install chromium",
    "test:design": "node tests/design.cjs",
    "check:public": "node scripts/check-public.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
